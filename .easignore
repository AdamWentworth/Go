# Keep EAS mobile archives free of local dependencies, credentials, and caches.
.git
node_modules
.npm/
.pnpm-store/
.yarn/
.env
.env.*
!.env.example
!.env.*.example
*.log
*.pid
.pytest_cache/
__pycache__/
*.py[cod]
.coverage
coverage/
.vite/
.vitest/
dist/
build/
.artifacts/
.vscode/
.idea/

# Expo generates native projects during EAS Build.
frontend/apps/mobile/.expo/
frontend/apps/mobile/android/
frontend/apps/mobile/ios/
frontend/apps/mobile/web-build/
frontend/apps/mobile/expo-env.d.ts
frontend/apps/mobile/*.tsbuildinfo

# The Android app only consumes the mobile workspace and shared mobile-safe
# packages. Exclude unrelated services, web-only code, tests, and large media.
/.github/
/assets/
/authentication/
/docs/
/editor/
/kafka/
/location/
/monitoring/
/nginx/
/notes/
/ops/
/pokemon/
/reader/
/receiver/
/storage/
/tests/
/frontend/apps/web/
/frontend/docs/
/frontend/packages/app-core/
/frontend/ROADMAP.md
