{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@pokemongonexus/shared-api-client": "file:../../packages/shared-api-client",
    "@pokemongonexus/shared-contracts": "file:../../packages/shared-contracts",
    "@pokemongonexus/shared-domain": "file:../../packages/shared-domain",
    "@pokemongonexus/shared-ui-tokens": "file:../../packages/shared-ui-tokens",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.102.2",
    "expo": "^56.0.0",
    "expo-constants": "~56.0.24",
    "expo-crypto": "~56.0.4",
    "expo-linking": "~56.0.17",
    "expo-router": "~56.2.19",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.14",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.14",
    "eslint": "^9.39.3",
    "eslint-config-expo": "~56.0.4",
    "jest": "29.7.0",
    "jest-expo": "~56.0.5",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^react$": "<rootDir>/node_modules/react",
      "^react/(.*)$": "<rootDir>/node_modules/react/$1"
    },
    "roots": [
      "<rootDir>/tests"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "private": true
}
