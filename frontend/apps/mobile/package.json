{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "start:native-preview": "cross-env EXPO_PUBLIC_MOBILE_EXPERIENCE=native-preview expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "device:smoke:android": "bash scripts/run-android-device-smoke.sh"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@pokemongonexus/shared-api-client": "file:../../packages/shared-api-client",
    "@pokemongonexus/shared-contracts": "file:../../packages/shared-contracts",
    "@pokemongonexus/shared-domain": "file:../../packages/shared-domain",
    "@pokemongonexus/shared-ui-tokens": "file:../../packages/shared-ui-tokens",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.102.2",
    "expo": "^57.0.9",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.14",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.14",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.3",
    "eslint-config-expo": "~57.0.1",
    "jest": "29.7.0",
    "jest-expo": "~57.0.4",
    "react-test-renderer": "19.2.8",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^react$": "<rootDir>/../../node_modules/react",
      "^react/(.*)$": "<rootDir>/../../node_modules/react/$1"
    },
    "roots": [
      "<rootDir>/tests"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "react"
      ]
    }
  },
  "private": true
}
